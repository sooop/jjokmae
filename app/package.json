{
  "name": "pdf-edit-app",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --mode dev",
    "build:static": "vite build --mode static",
    "build:single": "vite build --mode single",
    "build": "npm run build:static && npm run build:single",
    "check": "svelte-check --tsconfig ./tsconfig.json && tsc -p tsconfig.node.json",
    "e2e": "playwright test",
    "e2e:static": "playwright test --project=static",
    "e2e:single": "playwright test --project=single",
    "check:e2e": "tsc -p e2e/tsconfig.json"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tsconfig/svelte": "^5.0.8",
    "@types/node": "^26.6.6",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vite-plugin-singlefile": "^2.3.4"
  },
  "dependencies": {
    "@embedpdf/pdfium": "2.15.1",
    "mupdf": "1.28.6"
  }
}
